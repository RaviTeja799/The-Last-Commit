# Copy to .env and adjust if your setup differs. The app reads plain
# environment variables; there is no dotenv loader, so `export` them or use
# `set -a; . .env; set +a`.

# Where the local Ollama server listens. If you run a second server for an
# integrated GPU, point this at it (see README, "Speed").
OLLAMA_URL=http://127.0.0.1:11434

# The model the UI starts with. gemma3:4b follows the citation format best on
# small hardware; qwen2.5:3b is faster but tags citations less carefully.
GHOST_MODEL=gemma3:4b

# Where repositories and the SQLite archive live.
# GHOST_DATA_DIR=/absolute/path/to/data

# How many commits are read from a very large repository (default 220).
# GHOST_MAX_COMMITS=220
